<?xml version="1.0" encoding="utf-8"?>
<!--
    The encrypted settings file holds the user's API key. It is bound to the device's
    keystore, so it is excluded from backups to avoid restoring an undecryptable file.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="friday_secure_settings.xml" />
</full-backup-content>
