<?xml version="1.0" encoding="utf-8"?>
<!--
    The encrypted settings file holds the user's API key. It is bound to the device's
    keystore, so it is excluded from cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="friday_secure_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="friday_secure_settings.xml" />
    </device-transfer>
</data-extraction-rules>
